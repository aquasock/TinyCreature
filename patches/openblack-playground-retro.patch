+void Renderer::DrawPixelUpscale() const
+{
+	const auto viewId = static_cast<bgfx::ViewId>(RenderPass::PixelUpscale);
+	const auto* shader = _shaderManager->GetShader("PixelUpscale");
+	bgfx::setViewFrameBuffer(viewId, BGFX_INVALID_HANDLE);
+	bgfx::touch(viewId);
+	shader->SetTextureSampler("s_diffuse", 0, _pixelFrameBuffer->GetColorAttachment(),
+	                          BGFX_SAMPLER_POINT | BGFX_SAMPLER_U_CLAMP | BGFX_SAMPLER_V_CLAMP);
+	_plane->GetVertexBuffer().Bind();
+	bgfx::setState(BGFX_STATE_WRITE_RGB | BGFX_STATE_WRITE_A);
+	bgfx::submit(viewId, toBgfx(shader->GetRawHandle()));
+}
